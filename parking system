#include <iostream>
#include <string>
using namespace std;

struct Slot {
    bool occupied;
    string carNumber;
};

int main() {
    const int SIZE = 5; // عدد الأماكن في الجراج
    Slot parking[SIZE];

    // تهيئة الجراج
    for (int i = 0; i < SIZE; i++) {
        parking[i].occupied = false;
        parking[i].carNumber = "";
    }

    int choice;
    cout << "Parking System\n";
    cout << "1. Show Slots\n2. Park Car\n3. Remove Car\n4. Exit\n";

    while (true) {
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 1) {
            cout << "Parking Slots:\n";
            for (int i = 0; i < SIZE; i++) {
                cout << i+1 << ". ";
                if (parking[i].occupied)
                    cout << "Car " << parking[i].carNumber << endl;
                else
                    cout << "Empty\n";
            }
        } else if (choice == 2) {
            int slot; string car;
            cout << "Enter slot number (1-" << SIZE << "): ";
            cin >> slot;
            cout << "Enter car number: ";
            cin >> car;

            if (slot >= 1 && slot <= SIZE && !parking[slot-1].occupied) {
                parking[slot-1].occupied = true;
                parking[slot-1].carNumber = car;
                cout << "Car parked successfully!\n";
            } else {
                cout << "Invalid slot or already occupied!\n";
            }
        } else if (choice == 3) {
            int slot;
            cout << "Enter slot number to remove car: ";
            cin >> slot;

            if (slot >= 1 && slot <= SIZE && parking[slot-1].occupied) {
                parking[slot-1].occupied = false;
                parking[slot-1].carNumber = "";
                cout << "Car removed successfully!\n";
            } else {
                cout << "Invalid slot or already empty!\n";
            }
        } else if (choice == 4) {
            cout << "Exiting system...\n";
            break;
        } else {
            cout << "Invalid choice!\n";
        }
    }
    return 0;
}
