#include <iostream>
#include <string>
using namespace std;

struct Player {
    string name;
    int score;
};

string choiceToString(int choice) {
    string arr[3] = {"Rock", "Paper", "Scissors"};
    return arr[choice];
}

int getWinner(int pChoice, int cChoice) {
    if (pChoice == cChoice) return 0;
    if ((pChoice == 0 && cChoice == 2) || 
        (pChoice == 1 && cChoice == 0) || 
        (pChoice == 2 && cChoice == 1)) return 1;
    return -1;
}

void playGame(Player* player, Player* cpu) {
    int rounds;
    cout << "Enter number of rounds: ";
    cin >> rounds;

    for (int i = 0; i < rounds; i++) {
        int pChoice;
        cout << "\nChoose: 0=Rock, 1=Paper, 2=Scissors: ";
        cin >> pChoice;

        int cChoice = i % 3;
        cout << "Computer chose: " << choiceToString(cChoice) << endl;

        int result = getWinner(pChoice, cChoice);
        if (result == 0) {
            cout << "Draw!\n";
        } else if (result == 1) {
            cout << player->name << " wins!\n";
            player->score++;
        } else {
            cout << cpu->name << " wins!\n";
            cpu->score++;
        }
    }

    cout << "\nFinal Score:\n";
    cout << player->name << ": " << player->score << endl;
    cout << cpu->name << ": " << cpu->score << endl;
}

int main() {
    Player player = {"You", 0};
    Player cpu = {"Computer", 0};

    playGame(&player, &cpu);

    return 0;
}
